# Copy to qa/.env (lct init does it). qa/.env is git-ignored: never commit it.

# Jira base link (only needed when you pass a key like PROJ-123 instead of a full card link)
JIRA_URL=https://yourcompany.atlassian.net

# Name shown as "Tester" in reports (default: your Windows user name)
# QA_TESTER=Your Name

# page = browser-only screenshots (no taskbar); use it if you keep working while the AI tests
# QA_SNAP_MODE=page

# One block per app. The part after APP_ is the name you give `lct login`:
#   APP_MYAPP_*  ->  lct login myapp
APP_MYAPP_URL=https://test.myapp.example/login
APP_MYAPP_USER=testuser1
APP_MYAPP_PASS=
# Only if auto-detect of the login form fails (CSS selectors):
# APP_MYAPP_USER_FIELD=#username
# APP_MYAPP_PASS_FIELD=#password
# APP_MYAPP_SUBMIT=button[type=submit]

# Local demo app (lct demo)
APP_DEMO_URL=http://127.0.0.1:5175/login
APP_DEMO_USER=qa.tester
APP_DEMO_PASS=

# AJAX apps (e.g. ClaimCenter): after every action lct waits until requests are done and the page
# is quiet. If your app shows its own loading mask/spinner, put its CSS selector here once
# (find it with right-click > Inspect while it loads). Max wait per action in ms:
# LCT_BUSY_SELECTOR=.my-loading-mask
# LCT_SETTLE_MS=8000

# Optional: browser .exe (default: Edge) and debugging port
# LCT_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
# LCT_CDP_PORT=9333
