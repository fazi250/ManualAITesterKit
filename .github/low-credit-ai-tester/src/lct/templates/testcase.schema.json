{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test case (Low Credit AI Tester Kit)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "environment", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+-[0-9]+$", "description": "Jira key (PROJ-123) or TC-001. File name must match." },
    "title": { "type": "string", "minLength": 5, "maxLength": 150 },
    "jira": { "type": "string", "pattern": "^https?://", "description": "Card link" },
    "description": { "type": "string", "maxLength": 600, "description": "1-2 lines: what the card is about" },
    "status": { "enum": ["Not Run", "Pass", "Fail", "Blocked"], "description": "Leave out to derive it from the step results" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "app": { "type": "string", "description": "Name used with login.mts: APP_<APP>_URL/_USER/_PASS in qa/.env" },
        "url": { "type": "string", "pattern": "^https?://" },
        "name": { "type": "string", "description": "e.g. QA, UAT, Staging" },
        "build": { "type": "string" },
        "browser": { "type": "string" }
      }
    },
    "login": {
      "type": "object",
      "description": "No password field on purpose: it stays in qa/.env.",
      "additionalProperties": false,
      "properties": { "user": { "type": "string" } }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "expected"],
        "properties": {
          "action": { "type": "string", "maxLength": 200 },
          "expected": { "type": "string", "maxLength": 200 },
          "result": { "enum": ["Pass", "Fail", "Blocked"] },
          "actual": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "automationRefs": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
